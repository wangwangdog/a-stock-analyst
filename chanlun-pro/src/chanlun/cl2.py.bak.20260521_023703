"""
cl1.py — CZSC (waditu/czsc) 驱动的缠论分析器
========================================================
使用 CZSC Rust 原生引擎进行包含处理、分型识别、笔识别与中枢构建，
同时保留 chanlun-pro ICL 数据接口不动。

依赖: czsc >= 1.0.0  (底层 rs_czsc Rust 扩展)
"""

from __future__ import annotations
from typing import List, Dict, Any, Optional, Tuple, Union
import datetime as dt_module
import numpy as np
import pandas as pd

# ── CZSC 核心类型 ──
from czsc.core import CZSC as _CZSC
from czsc.core import RawBar, NewBar, Freq, Direction as _Direction
from rs_czsc import Mark as _Mark

# ── chanlun-pro 接口 ──
from chanlun.cl_interface import (
    ICL, Kline as CL_Kline, CLKline, FX, BI, XD, ZS, MMD, BC,
    LINE, Config, compare_ld_beichi,
)


# ── 全局调试开关 ──
SHOW_UNFINISHED_BI = False          # 未结束笔：最后一笔终点未连到最近k线柱时，补未结束笔，默认关闭
SHOW_ENTRY_BOUND_CHECK = True       # 步2a: 进入笔外侧检查(起点穿透中框)，默认开启
SHOW_ZHONGSHU_CHECK_OVERLAP = False  # 步4c: 离开笔外侧检查，默认关闭
SHOW_ENTRY_REASONABLE_CHECK = True   # 步2b: 进入笔合理检测，默认开启
SHOW_EXIT_REASONABLE_CHECK = True     # 步4d: 离开笔合理检测，默认开启
ZS_CANDIDATE_PENS = 5               # 候选笔数


# ═══════════════════════════════════════════════════════════════════════
# 常量映射
# ═══════════════════════════════════════════════════════════════════════

_FREQ_MAP = {
    "F1": Freq.F1, "1m": Freq.F1, "1分钟": Freq.F1,
    "F5": Freq.F5, "5m": Freq.F5, "5分钟": Freq.F5,
    "F15": Freq.F15, "15m": Freq.F15, "15分钟": Freq.F15,
    "F30": Freq.F30, "30m": Freq.F30, "30分钟": Freq.F30,
    "F60": Freq.F60, "60m": Freq.F60, "60分钟": Freq.F60,
    "D": Freq.D, "day": Freq.D, "日线": Freq.D,
    "W": Freq.W, "week": Freq.W, "周线": Freq.W,
    "M": Freq.M, "month": Freq.M, "月线": Freq.M,
}


# ═══════════════════════════════════════════════════════════════════════
# 辅助函数
# ═══════════════════════════════════════════════════════════════════════

def _to_dt(val):
    """统一转换为 datetime"""
    if isinstance(val, dt_module.datetime):
        return val
    if isinstance(val, str):
        try:
            return dt_module.datetime.strptime(str(val)[:19], "%Y-%m-%d %H:%M:%S")
        except ValueError:
            return dt_module.datetime.strptime(str(val)[:10], "%Y-%m-%d")
    if isinstance(val, (int, float)):
        return dt_module.datetime.fromtimestamp(val / 1000 if val > 1e9 else val)
    return val


def _freq_str_to_czsc(freq: str) -> Freq:
    """将 chanlun-pro 频次字符串映射为 CZSC Freq 枚举"""
    f = _FREQ_MAP.get(freq)
    if f is None:
        for k, v in _FREQ_MAP.items():
            if k in freq or freq in k:
                return v
        return Freq.D
    return f


def _mark_to_type(mark: _Mark) -> str:
    """CZSC Mark → chanlun-pro 分型类型字符串"""
    return "ding" if mark == _Mark.G else "di"


def _type_to_mark(t: str) -> _Mark:
    return _Mark.G if t == "ding" else _Mark.D


def _direction_to_type(d: _Direction) -> str:
    return "up" if d == _Direction.Up else "down"


# ═══════════════════════════════════════════════════════════════════════
# 中枢构建（5笔中枢 + 保留旧3笔辅助函数）
# ═══════════════════════════════════════════════════════════════════════

def _find_parent_segment_dir(bis: List[BI], start_idx: int) -> str:
    """
    根据当前 bis 的宏观结构推断"高一级别"方向。
    取 start_idx 之前最近一段同向笔簇的方向作为 parent 方向。
    """
    if start_idx < 2:
        return "up"
    nearby = bis[max(0,start_idx-4):start_idx]
    ups = sum(1 for b in nearby if b.type == "up")
    downs = sum(1 for b in nearby if b.type == "down")
    if ups > downs:
        return "up"
    elif downs > ups:
        return "down"
    return bis[min(start_idx,len(bis)-1)].type if start_idx < len(bis) else "up"


def _candidate_pattern(parent_dir: str) -> tuple:
    """
    根据高一级别方向返回候选三笔形态。
    - parent=up → candidate=下-上-下（第1笔下,第2笔上,第3笔下）
    - parent=down → candidate=上-下-上
    返回 (bi1_type, bi2_type, bi3_type)
    """
    if parent_dir == "down":
        return ("up", "down", "up")
    else:
        return ("down", "up", "down")


def _check_within_parent_boundary(
    bi1: BI, bi2: BI, bi3: BI, parent_start: BI, parent_end: BI
) -> bool:
    """
    检查候选三笔是否完全落在同一高一级别笔边界内。
    """
    s_idx = min(bi1.start.k.k_index, bi2.start.k.k_index, bi3.start.k.k_index)
    e_idx = max(bi1.end.k.k_index, bi2.end.k.k_index, bi3.end.k.k_index)
    p_s = parent_start.start.k.k_index
    p_e = parent_end.end.k.k_index
    return s_idx >= p_s and e_idx <= p_e


def _check_middle_overlap(bi1: BI, bi2: BI, bi3: BI) -> tuple:
    """
    检查中间3笔是否存在价格重叠区间。
    返回 (zg, zd, gg, dd) 或 None。
    """
    h1, l1 = bi1.high, bi1.low
    h2, l2 = bi2.high, bi2.low
    h3, l3 = bi3.high, bi3.low
    zg = min(h1, h2, h3)
    zd = max(l1, l2, l3)
    gg = max(h1, h2, h3)
    dd = min(l1, l2, l3)
    return (zg, zd, gg, dd) if zg > zd else None


def _is_overlap(bi_list: List[BI]) -> bool:
    """判断一组笔是否有公共重叠区域"""
    if not bi_list:
        return False
    min_high = min(bi.high for bi in bi_list)
    max_low = max(bi.low for bi in bi_list)
    return min_high >= max_low

def _five_bi_condition(bis: List[BI], i: int) -> bool:
    """
    5笔形态检查：进入笔与离开笔同向 + 中间3笔重叠。
    返回 True（检查通过）或 False（不通过）。
    """
    n = ZS_CANDIDATE_PENS
    if i + n > len(bis):
        return False

    b1 = bis[i]
    b_exit = bis[i + n - 1]
    if b_exit.type != b1.type:
        return False

    # 中间N-2笔必须价格重叠
    middle = bis[i + 1:i + n - 1]
    if not _is_overlap(middle):
        return False

    return True


def _check_entry_bound(b1: BI, middle: List[BI], zs_dir: str) -> bool:
    """进入笔外侧检查：获取进入笔(b1)的起点值，穿透中框才放行。
       上涨中枢(b1=up) → 起点值低于ZD
       下跌中枢(b1=down) → 起点值高于ZG
    """
    if not SHOW_ENTRY_BOUND_CHECK:
        return True
    zg = min(b.high for b in middle)
    zd = max(b.low for b in middle)
    if zs_dir == "up":  # b1=up, 上涨中枢 → 起点值低于ZD
        return b1.start.val < zd
    else:  # zs_dir == "down", b1=down, 下跌中枢 → 起点值高于ZG
        return b1.start.val > zg


def _check_exit_bound(b_exit: BI, middle: List[BI], zs_dir: str) -> bool:
    """离开笔外侧检查：b_exit.start 必须在中间3笔重叠区间外侧。"""
    if not SHOW_ZHONGSHU_CHECK_OVERLAP:
        return True
    zg = min(b.high for b in middle)
    zd = max(b.low for b in middle)
    if zs_dir == "up":  # b1=up, 上涨中枢 → 离开笔起点在重叠下方
        return b_exit.start.val <= zd
    else:  # zs_dir == "down", b1=down, 下跌中枢 → 离开笔起点在重叠上方
        return b_exit.start.val >= zg


def _check_entry_reasonable(b1: BI, zg: float, zd: float) -> bool:
    """进入笔合理检测：进入笔起点必须穿透中框（ZG/ZD）。
       - b1=up: 起点(低位) < ZD
       - b1=down: 起点(高位) > ZG
    """
    if not SHOW_ENTRY_REASONABLE_CHECK:
        return True
    if b1.type == "up":
        return b1.start.val < zd
    else:
        return b1.start.val > zg


def _check_exit_reasonable(b_exit: BI, zg: float, zd: float, zs_dir: str) -> bool:
    """离开笔合理检测：离开笔终点必须在中枢区间外。
       - zs_dir="up":   exit.end > ZG（高点突破上沿）
       - zs_dir="down": exit.high < ZD（低点跌破下沿）
    """
    if not SHOW_EXIT_REASONABLE_CHECK:
        return True
    if zs_dir == "up":  # b1=up, exit=up
        return b_exit.end.val > zg
    else:  # zs_dir == "down", b1=down, exit=down
        return b_exit.high < zd


def _calc_zs_zgzd(bis: List[BI], i: int, exit_idx: int, zs_dir: str):
    """
    计算中枢 ZG/ZD/GG/DD。

    使用所有中间笔的高低点：
    上沿 ZG = 中间笔高点的最小值
    下沿 ZD = 中间笔低点的最大值
    GG = 中间笔最高, DD = 中间笔最低
    """
    n = ZS_CANDIDATE_PENS  # 固定候选笔数=5
    middle_pens = bis[i + 1:i + n - 1]  # 固定取b2,b3,b4，不随exit_idx扩大
    if not middle_pens:
        return (0.0, 0.0, 0.0, 0.0)
    # 使用所有中间笔的高低点
    highs = [bi.high for bi in middle_pens]
    lows = [bi.low for bi in middle_pens]
    zg = min(highs)  # 上沿 = 高点最小值
    zd = max(lows)   # 下沿 = 低点最大值
    gg = max(highs)  # 最高
    dd = min(lows)   # 最低
    return zg, zd, gg, dd


def _classify_trend_type(zss: List[ZS], bis: List[BI], zs: ZS) -> str:
    """判断走势类型：趋势上涨/趋势下跌/盘整上涨/盘整下跌"""
    direction = zs.type
    same_dir_count = sum(1 for z in zss if z.type == direction)
    if same_dir_count >= 2:
        return "趋势上涨" if direction == "up" else "趋势下跌"
    else:
        return "盘整上涨" if direction == "up" else "盘整下跌"


def _get_zs_name(zss_sofar: list, zs: ZS) -> str:
    """中枢命名：A, B, C..."""
    same_dir = [z for z in zss_sofar if z.type == zs.type]
    return chr(65 + len(same_dir))  # 65='A'


def _build_bi_zss(bis: List[BI], config: dict = None) -> List[ZS]:
    """
    5笔中枢构建，离开笔支持后扫（b5→b7→b9...）。

    流程（括号内标注全局变量是否开关: 0=关, 1=开）：
    步1: 扫描窗口 + 跳过已用笔                         (1)
    ────────────────────────────────
    步2: 进入笔合理性判断
      2a: 外侧检查  → SHOW_ENTRY_BOUND_CHECK           (1)
      2b: 合理检测  → SHOW_ENTRY_REASONABLE_CHECK       (1)
    ────────────────────────────────
    步3: 重叠区检查（b2,b3,b4必须重叠，不重叠则标记b1为已用） (1)
    ────────────────────────────────
    步4: 后扫离开笔 b5→b7→b9...
      4a: 方向一致                                      (1)
      4b: 固定b2,b3,b4算 ZG/ZD                          (1)
      4c: 外侧检查  → SHOW_ZHONGSHU_CHECK_OVERLAP       (0)
      4e: 整笔在中枢内则后扫（cand.high≤ZG且cand.low≥ZD→继续）(1)
      4d: 合理检测  → SHOW_EXIT_REASONABLE_CHECK        (1)
          zs_dir="up": exit.end>ZG（高点突破上沿）, zs_dir="down": exit.high<ZD（低点跌破下沿）
    ────────────────────────────────
    步5: 构建中枢                                       (1)
    步6: 重叠合并（zs_combine）                        (1)
    步7: 标记已用笔（离开笔保留）                       (1)
    步8: 完成态标记                                     (1)
    参数：
        zs_combine=0  合并策略：0全部新生，1重叠合并
    """
    config = config or {}
    if len(bis) < 5:
        return []

    zss: List[ZS] = []
    used_indices: set = set()
    n = ZS_CANDIDATE_PENS  # = 5

    # ── 1. 扫描所有5笔窗口 ──
    for i in range(len(bis) - n + 1):
        b1 = bis[i]
        if b1.index in used_indices:
            continue

        # ── 2. 进入笔合理性判断（外侧检查 + 合理检测）──
        middle = bis[i + 1:i + n - 1]
        zs_dir = b1.type  # zs_dir="up" → b1=up, zs_dir="down" → b1=down
        # 2a. 外侧检查：b1.start 穿透中框
        if not _check_entry_bound(b1, middle, zs_dir):
            used_indices.add(b1.index)
            continue
        # 2b. 合理检测：b1.start 穿透中框（用 b2,b3,b4 算 ZG/ZD）
        entry_zg, entry_zd, _, _ = _calc_zs_zgzd(bis, i, i + n - 1, zs_dir)
        if entry_zg == 0 and entry_zd == 0:
            continue
        if not _check_entry_reasonable(b1, entry_zg, entry_zd):
            used_indices.add(b1.index)
            continue

        # ── 3. 重叠区检查：中间3笔必须重叠，不重叠则标记进入笔为已用 ──
        if not _is_overlap(bis[i + 1:i + n - 1]):
            used_indices.add(b1.index)
            continue

        # ── 4. 后扫离开笔 b5→b7→b9... ──
        exit_idx = None
        b_exit = None
        zs_zg = zs_zd = zs_gg = zs_dd = 0
        ei = i + n - 1  # 起始=b5
        while ei < len(bis):
            cand = bis[ei]
            # 4a. 离开笔与进入笔必须严格同向
            if cand.type == b1.type:
                # 4b. 方向化算 ZG/ZD/GG/DD
                zg, zd, gg, dd = _calc_zs_zgzd(bis, i, ei, zs_dir)
                if not (zg == 0 and zd == 0):
                    # 4c. 离开笔外侧检查
                    if _check_exit_bound(cand, middle, zs_dir):
                        # 4e. 笔身完全在中枢内 → 继续后扫
                        if zg >= zd and cand.high <= zg and cand.low >= zd:
                            ei += 2
                            continue
                        # 4d. 离开笔合理检测
                        if _check_exit_reasonable(cand, zg, zd, zs_dir):
                            exit_idx = ei
                            b_exit = cand
                            zg, zd, gg, dd = zg, zd, gg, dd
                            break
            ei += 2  # 步进2

        if exit_idx is None:
            continue

        # ── 5. 构建中枢对象 ──
        zs = ZS(
            zs_type="bi",
            start=b1.end,
            end=b_exit.start,
            zg=zg, zd=zd, gg=gg, dd=dd,
            _type=zs_dir,
            index=len(zss),
            line_num=exit_idx - i + 1,
            level=0,
        )
        zs.lines = bis[i:exit_idx + 1]
        zs.done = True

        # 标注字段
        setattr(zs, "trend_type", _classify_trend_type(zss, bis, zs))
        setattr(zs, "segment_index", len(zss))
        setattr(zs, "name", _get_zs_name(zss, zs))
        setattr(zs, "entry_bi", b1)
        setattr(zs, "entry_bi_idx", b1.index)
        setattr(zs, "exit_bi", b_exit)
        setattr(zs, "exit_bi_idx", b_exit.index)
        setattr(zs, "bi_indices", [bi.index for bi in zs.lines])

        # ── 6. 重叠合并（zs_combine）──
        overlap_with_prev = False
        for prev_zs in reversed(zss):
            if prev_zs.type != zs.type:
                continue
            if not (zs.dd > prev_zs.gg or zs.gg < prev_zs.dd):
                overlap_with_prev = True
                break

        if config.get('zs_combine', 0) and overlap_with_prev and zss:
            for prev_zs in reversed(zss):
                if prev_zs.type == zs.type:
                    prev_zs.lines.extend(zs.lines)
                    prev_zs.line_num = len(prev_zs.lines)
                    prev_zs.end = zs.lines[-1].end
                    break
        else:
            zss.append(zs)

        # ── 7. 标记已用笔（从进入笔到离开笔前一笔，离开笔保留给下一个中枢）──
        for j in range(i, exit_idx):
            used_indices.add(bis[j].index)

    # ── 8. 完成态标记 ──
    if zss:
        zss[-1].done = False
        if len(zss) >= 2:
            zss[-2].done = True

    return zss


